{
  "name": "oma-ai",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22 <25",
    "pnpm": ">=9"
  },
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build && pnpm -r --filter=./apps/* build",
    "dev:api": "pnpm --filter @oma/api dev",
    "dev:web": "pnpm --filter @oma/web dev",
    "dev:worker": "pnpm --filter @oma/worker dev",
    "dev:local": "bash scripts/dev-local.sh",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:unit": "vitest run packages apps tests/dev-os",
    "test:devos": "vitest run tests/dev-os",
    "test:integration": "vitest run tests/integration tests/security tests/contract",
    "test:contract": "vitest run tests/contract",
    "test:security": "vitest run tests/security",
    "test:e2e": "playwright test",
    "openapi:generate": "pnpm --filter @oma/api exec tsx src/generate-openapi.ts",
    "db:generate": "pnpm --filter @oma/db generate",
    "db:migrate": "pnpm --filter @oma/db migrate:dev",
    "db:migrate:deploy": "pnpm --filter @oma/db migrate:deploy",
    "db:seed": "pnpm --filter @oma/db seed",
    "db:seed:demo": "pnpm --filter @oma/db seed:demo",
    "db:seed:review:002": "pnpm --filter @oma/db seed:review:002",
    "review:002": "bash scripts/review-002.sh",
    "review:002:stop": "bash scripts/review-002-stop.sh",
    "db:seed:review:003": "pnpm --filter @oma/db seed:review:003",
    "review:003": "bash scripts/review-003.sh",
    "review:003:stop": "bash scripts/review-003-stop.sh",
    "audit:deps": "pnpm audit --prod",
    "ui:inventory-runtime": "node scripts/ui/inventory-runtime-styles.mjs",
    "ui:inventory-visual": "node scripts/ui/inventory-visual-primitives.mjs",
    "ref:launch": "node scripts/reference/launch-reference-browser.mjs",
    "ref:preflight": "node scripts/reference/cdp-preflight.mjs",
    "ref:smoke": "node scripts/reference/reference-worker-smoke.mjs",
    "ref:inspect": "node scripts/reference/inspect-reference.mjs",
    "ref:validate": "node scripts/reference/validate-reference-artifacts.mjs",
    "ref:our-nav": "node scripts/reference/build-our-navigation-map.mjs",
    "ref:parity": "node scripts/reference/parity-report.mjs",
    "devos:validate": "node scripts/dev-os/validate-development-os.mjs",
    "devos:doctor": "node scripts/dev-os/doctor.mjs",
    "dev-os:validate": "node scripts/dev-os/validate-development-os.mjs",
    "dev-os:doctor": "node scripts/dev-os/doctor.mjs",
    "dev-os:stage": "node scripts/dev-os/cost/run-stage.mjs",
    "dev-os:token-waste": "node scripts/dev-os/cost/token-waste-audit.mjs",
    "dev-os:usage-ledger": "node scripts/dev-os/cost/usage-ledger.mjs",
    "dev-os:usage-analyze": "node scripts/dev-os/cost/analyze-usage-export.mjs",
    "dev-os:cost-test": "node scripts/dev-os/cost/test-cost-routing.mjs",
    "dev-os:auto-ledger-test": "node scripts/dev-os/cost/test-auto-ledger.mjs",
    "dev-os:golden-compare": "node scripts/dev-os/golden/compare-golden-baseline.mjs",
    "dev-os:test": "vitest run tests/dev-os",
    "dev-os:test-all": "vitest run tests/dev-os && node scripts/dev-os/cost/test-cost-routing.mjs && node scripts/dev-os/cost/test-auto-ledger.mjs && node scripts/dev-os/cost/token-waste-audit.mjs && node scripts/dev-os/golden/compare-golden-baseline.mjs && node scripts/dev-os/validate-development-os.mjs",
    "review:004": "bash scripts/review-004.sh",
    "review:004:stop": "bash scripts/review-004-stop.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@nestjs/common": "^11.0.11",
    "@nestjs/core": "^11.0.11",
    "@nestjs/platform-express": "^11.0.11",
    "@playwright/test": "^1.51.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/node": "^22.13.10",
    "bullmq": "^5.41.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "eslint": "^9.22.0",
    "ioredis": "^5.5.0",
    "prettier": "^3.5.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.23",
      "deepmerge-ts": ">=8.0.0",
      "sharp": ">=0.35.4",
      "qs": ">=6.16.0",
      "next": "15.5.24",
      "multer": ">=2.3.0"
    }
  }
}
