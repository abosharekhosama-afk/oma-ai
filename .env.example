# Leave unset for `next build`; set to development only for local runtime.
# NODE_ENV=development
DATABASE_URL=postgresql://oma@127.0.0.1:5432/oma_ai?schema=public
REDIS_URL=redis://127.0.0.1:6379
API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://127.0.0.1:3000
WEB_BASE_URL=http://127.0.0.1:3000
# Public web origin used as the verified URL prefix for TikTok media proxying.
MEDIA_PROXY_ORIGIN=http://127.0.0.1:3000
API_PUBLIC_URL=http://127.0.0.1:3001
WORKER_HEALTH_PORT=3002
SESSION_COOKIE_NAME=oma_session
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=oma_csrf
BOOTSTRAP_PLATFORM_OWNER_EMAIL=platform-owner@example.com
BOOTSTRAP_PLATFORM_OWNER_PASSWORD=ChangeMe_PlatformOwner_1!
# Brand website intelligence
# live = first-party public HTTPS crawler (default when fixture is off)
# fixture = local HTML fixtures only (never honored in production)
# disabled = refuse fetches; connecting a website still stores the URL
BRAND_WEBSITE_CONNECTOR=live
# Legacy opt-in used by tests/local demo. Ignored in production.
BRAND_FIXTURE_CONNECTOR=0
BRAND_MAX_PAGES=50
BRAND_MAX_DEPTH=3
BRAND_MAX_DURATION_SECONDS=600
BRAND_MAX_BYTES=1000000
BRAND_MAX_SITEMAP_DOCUMENTS=5
BRAND_SCANNER_USER_AGENT=OMA-BrandScanner/1.0 (+https://oma.ai)
BRAND_SCANNER_ACCEPT_LANGUAGE=en,ar;q=0.9
BRAND_SCANNER_TIMEOUT_MS=15000
BRAND_SCANNER_CONNECT_TIMEOUT_MS=5000
BRAND_SCANNER_MAX_REDIRECTS=5
BRAND_SCANNER_CONCURRENCY=1
BRAND_SCANNER_DELAY_MS=500
BRAND_SCANNER_MAX_RETRIES=2
BRAND_ALLOWED_PORTS=80,443
# Test-only loopback override. Cannot be enabled when NODE_ENV=production.
BRAND_SCANNER_ALLOW_PRIVATE_HOSTS=0
# Feature 003 — AI propose refuses (DEC-016). No vendor keys.
STRATEGY_AI_MODE=refuse

# OpenAI text intelligence (offline-ready adapter; AI_LIVE_ENABLED must stay false until billing)
# Text analysis/generation only — no image/video/audio/realtime SDKs.
# Never commit real secrets; copy into local .env only.
AI_PROVIDER=openai
AI_LIVE_ENABLED=false
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
AI_DEFAULT_MODEL=gpt-5.6-luna
AI_REASONING_MODEL=gpt-5.6-terra
AI_MONTHLY_BUDGET_USD=25
AI_DAILY_BUDGET_USD=2
AI_MAX_INPUT_TOKENS=
AI_MAX_OUTPUT_TOKENS=
AI_MAX_TENANT_CONCURRENCY=2


# Playwright E2E isolation (required for pnpm test:e2e)
E2E_DATABASE_URL=postgresql://oma@127.0.0.1:5432/oma_ai_e2e?schema=public
E2E_REDIS_URL=redis://127.0.0.1:6379/1
# OMA_E2E_ALLOW_DEV_DB=1  # explicit override only; never use against production

# Complete-product demo surfaces (blocked in production)
OMA_DEMO_MODE=0

# Social accounts (see docs/social-setup.md). Leave blank to show "Not available yet".
SOCIAL_TOKEN_ENCRYPTION_KEY=

# Imkan WorkDrive media storage (docs/workdrive-setup.md)
# 64 hex chars (openssl rand -hex 32). Falls back to SOCIAL_TOKEN_ENCRYPTION_KEY when empty.
WORKDRIVE_ENCRYPTION_KEY=
# Pre-filled address on the WorkDrive settings screen (optional).
WORKDRIVE_DEFAULT_URL=
# Platform-master WorkDrive for OMA_INTERNAL storage (not stored in WorkDriveConnection).
# Workspaces can upload without connecting their own key when these are set.
WORKDRIVE_MASTER_BASE_URL=
WORKDRIVE_MASTER_API_KEY=
# Upload limits in MB.
WORKDRIVE_MAX_VIDEO_MB=500
WORKDRIVE_MAX_IMAGE_MB=25
# Worker: data-URL logo migration + missing-file check interval (ms).
WORKDRIVE_MIGRATION_INTERVAL_MS=600000
# Allow private/LAN WorkDrive addresses in production (default off).
WORKDRIVE_ALLOW_PRIVATE_URLS=

# HMAC secret shared with WorkDrive outgoing webhooks (also sent when registering).
WORKDRIVE_WEBHOOK_SECRET=
# Public URL of POST /api/v1/integrations/workdrive/webhook
WORKDRIVE_WEBHOOK_PUBLIC_URL=
# Allowed timestamp skew in seconds (default 300).
WORKDRIVE_WEBHOOK_TOLERANCE_SEC=300

# SYNC_BACKUP worker (copy OMA_INTERNAL files to the workspace WorkDrive).
STORAGE_BACKUP_TICK_MS=15000
STORAGE_BACKUP_BATCH_SIZE=10
STORAGE_BACKUP_CONCURRENCY=2
STORAGE_BACKUP_MAX_ATTEMPTS=8
STORAGE_BACKUP_BACKOFF_MS=30000
STORAGE_BACKUP_MAX_BACKOFF_MS=3600000
# Streaming copy: refuse to buffer a whole object larger than this when sha256 is missing (default 32MB).
# Unused for refusal: copies stream-hash when sha256 is missing. Kept for compatibility.
STORAGE_COPY_MAX_BUFFER_BYTES=33554432
# Orphan cleanup: walk only tenants/{tenantId}/... on the master account.
STORAGE_ORPHAN_GRACE_DAYS=7
# Dry-run defaults ON unless NODE_ENV=production. Set 0 to actually trash orphans.
STORAGE_ORPHAN_DRY_RUN=1
STORAGE_ORPHAN_TICK_MS=3600000
STORAGE_ORPHAN_BATCH_SIZE=50
STORAGE_ORPHAN_MAX_FILES=500
# Compare recorded OMA_INTERNAL usage vs platform WorkDrive GET /storage/quota.
STORAGE_QUOTA_RECONCILE_TICK_MS=21600000
SOCIAL_OAUTH_REDIRECT_BASE=
# Optional explicit callback URLs. When set, these override SOCIAL_OAUTH_REDIRECT_BASE
# for the matching provider. They must match the provider dashboard exactly.
TIKTOK_REDIRECT_URI=
META_FACEBOOK_REDIRECT_URI=
META_INSTAGRAM_REDIRECT_URI=
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Set to 1 only after TikTok approves the video.publish scope for the app.
TIKTOK_ENABLE_DIRECT_POST=0
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=
X_WEBHOOK_SECRET=

# Meta webhooks (Facebook, Instagram, WhatsApp Cloud API). Same verify token for all.
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_REDIRECT_URI=
META_WHATSAPP_REDIRECT_URI=
# Optional: subscribe WhatsApp Cloud API app to this WABA after connect.
WHATSAPP_BUSINESS_ACCOUNT_ID=

TIKTOK_WEBHOOK_SECRET=
LINKEDIN_WEBHOOK_SECRET=
LINKEDIN_REDIRECT_URI=

# Worker cadence for due posts / token refresh / inbox pull
SOCIAL_PUBLISH_INTERVAL_MS=30000
SOCIAL_REFRESH_INTERVAL_MS=900000
SOCIAL_INSIGHTS_INTERVAL_MS=900000
INBOX_SYNC_DAYS=14
INBOX_CONCURRENCY=5
# Fallback tenant if a webhook cannot be mapped to a connected page.
INBOX_DEFAULT_TENANT_ID=

# Email (worker + API). MAIL_PROVIDER=resend|brevo|console.
# If MAIL_PROVIDER is omitted, OMA detects Resend/Brevo from the API key.
# These variables must be set on BOTH the API and worker services.
# MAIL_PROVIDER=brevo
# BREVO_API_KEY=
# RESEND_API_KEY=
# MAIL_FROM=OMA <no-reply@mail.yourdomain.com>
# MAIL_REPLY_TO=support@yourdomain.com

# Unified Inbox + Social Listening demo seed (packages/db).
# SEED_INBOX_DEMO=1 pnpm --filter @oma/db seed:inbox-demo
SEED_INBOX_DEMO=
# Optional tenant slug (default: oma-demo, else first tenant)
SEED_INBOX_DEMO_TENANT_SLUG=
# Required together with SEED_INBOX_DEMO=1 when NODE_ENV=production
SEED_INBOX_DEMO_ALLOW_PROD=

# ─── Billing, plans, and payments (see docs/billing.md) ───────────────────────
# VAT is stored in BillingSettings (default 1700 bps = 17%). Change to 1800 for Israel (18%).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Public site URL used for Checkout success/cancel and the Stripe customer portal.
# WEB_BASE_URL=https://app.example.com
# Lahza is Bank of Palestine’s documented payment gateway (https://docs.lahza.io).
# LAHZA_SECRET_KEY=
# LAHZA_PUBLIC_KEY=
# LAHZA_WEBHOOK_SECRET=
# Optional feature flags: show manual Palestinian provider flows (no invented APIs).
# JAWWAL_PAY_ENABLED=0
# PALPAY_ENABLED=0
# REFLECT_ENABLED=0
# Set to 1 to hide generic bank transfer.
# BILLING_BANK_TRANSFER_DISABLED=0
