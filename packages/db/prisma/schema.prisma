generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DEAD
}

model User {
  id               String       @id
  email            String       @unique
  emailVerifiedAt  DateTime?
  passwordHash     String?
  name             String
  preferredLocale  String       @default("en")
  preferredDir     String       @default("ltr")
  avatarUrl        String?
  /// JSON: { notifications: { [type]: boolean }, timezone, weekStart, ... }
  preferencesJson  String       @default("{}")
  status           UserStatus   @default(ACTIVE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  sessions         Session[]
  memberships      Membership[]
  auditEvents      AuditEvent[] @relation("ActorUser")
}

model Session {
  id             String    @id
  userId         String
  tokenHash      String    @unique
  activeTenantId String?
  ip             String?
  userAgent      String?
  createdAt      DateTime  @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  lastSeenAt     DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id])
  activeTenant   Tenant?   @relation(fields: [activeTenantId], references: [id])

  @@index([userId])
}

model Tenant {
  id              String              @id
  name            String
  slug            String              @unique
  status          TenantStatus        @default(ACTIVE)
  defaultLocale   String              @default("en")
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  version         Int                 @default(1)
  memberships     Membership[]
  sessions        Session[]
  grants          CapabilityGrant[]
  audits          AuditEvent[]
  outbox          OutboxEvent[]
  jobs            JobRun[]
  notifications   Notification[]
  idempotency     IdempotencyRecord[]
  brandWorkspaces BrandWorkspace[]
  aiRuns          AiRun[]
  workspaceSetting WorkspaceSetting?
  timeSlots       WorkspaceTimeSlot[]
}

enum AiRunStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  DISABLED
  SCHEMA_INVALID
  REFUSED
}

/// Tenant-scoped text-intelligence run. No prompts, chain-of-thought, or secrets.
model AiRun {
  id               String      @id
  tenantId         String
  actorUserId      String
  useCase          String
  provider         String
  model            String
  promptVersion    String
  schemaVersion    String
  sourceEntityType String
  sourceEntityId   String
  sourceVersion    String
  status           AiRunStatus @default(DISABLED)
  idempotencyKey   String
  correlationId    String?
  inputHash        String
  outputHash       String?
  inputTokens      Int         @default(0)
  outputTokens     Int         @default(0)
  estimatedCost    String      @default("0")
  reservedCost     String      @default("0")
  settledCost      String      @default("0")
  latencyMs        Int?
  errorCode        String?
  refusalReason    String?
  proposalJson     String?
  version          Int         @default(1)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tenant           Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

model Membership {
  id             String           @id
  tenantId       String
  userId         String?
  status         MembershipStatus @default(INVITED)
  /// Planable: team | client
  membershipKind String           @default("team")
  /// Planable display role e.g. Owner, Contributor, Approver
  displayRole    String?
  invitedEmail   String?
  invitedBy      String?
  invitedAt      DateTime?
  acceptedAt     DateTime?
  suspendedAt    DateTime?
  removedAt      DateTime?
  version        Int              @default(1)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  user           User?            @relation(fields: [userId], references: [id])
  grants         CapabilityGrant[]
  invitations    Invitation[]

  @@index([tenantId, status])
  @@index([tenantId, membershipKind])
  @@index([userId])
}

model Invitation {
  id           String     @id
  membershipId String
  tokenHash    String     @unique
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  membership   Membership @relation(fields: [membershipId], references: [id])
}

model CapabilityProfile {
  id              String   @id
  code            String
  nameKey         String
  capabilityCodes String[]
  tenantId        String?
  isSystem        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@unique([code, tenantId])
}

model CapabilityGrant {
  id                String     @id
  membershipId      String
  tenantId          String
  capabilityCode    String
  scopeJson         String?
  sourceProfileCode String?
  grantedBy         String?
  grantedAt         DateTime   @default(now())
  revokedAt         DateTime?
  membership        Membership @relation(fields: [membershipId], references: [id])
  tenant            Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId, membershipId])
  @@index([membershipId, capabilityCode])
}

model AuditEvent {
  id            String   @id
  occurredAt    DateTime @default(now())
  actorUserId   String?
  actorType     String
  tenantId      String?
  action        String
  targetType    String?
  targetId      String?
  beforeRef     String?
  afterRef      String?
  correlationId String?
  requestId     String?
  ip            String?
  actorUser     User?    @relation("ActorUser", fields: [actorUserId], references: [id])
  tenant        Tenant?  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, occurredAt])
}

model IdempotencyRecord {
  id             String   @id
  tenantId       String
  actorUserId    String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   String
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, actorUserId, key])
}

model OutboxEvent {
  id          String       @id
  tenantId    String?
  eventType   String
  payloadJson String
  createdAt   DateTime     @default(now())
  publishedAt DateTime?
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  tenant      Tenant?      @relation(fields: [tenantId], references: [id])

  @@index([status, createdAt])
}

model JobRun {
  id             String    @id
  tenantId       String?
  queue          String
  jobType        String
  status         JobStatus @default(QUEUED)
  payloadJson    String
  actorUserId    String?
  correlationId  String?
  errorCode      String?
  errorDetail    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  /// When set, must be unique so retries cannot spawn a duplicate JobRun row.
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())
  tenant         Tenant?   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([queue, status, createdAt])
}

model Notification {
  id                  String    @id
  tenantId            String
  recipientUserId     String
  type                String
  objectType          String?
  objectId            String?
  deepLinkPath        String
  readAt              DateTime?
  dedupeKey           String
  sourceOutboxEventId String?
  createdAt           DateTime  @default(now())
  tenant              Tenant    @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, dedupeKey])
  @@index([recipientUserId, createdAt])
}

model RecoveryToken {
  id        String    @id
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// --- Brand Website Intelligence (002) ---

enum BrandWorkspaceStatus {
  DRAFT
  READY_TO_SCAN
  ACTIVE
  ARCHIVED
}

enum WebsiteValidationStatus {
  VALID
  REJECTED
}

enum ScanAttemptStatus {
  QUEUED
  CRAWLING
  EXTRACTING
  ANALYZING
  SUCCEEDED
  PARTIAL
  FAILED
  CANCELLED
}

enum ScanTrigger {
  START
  RETRY
  RESCAN
}

enum BrandAiAvailability {
  NOT_CONFIGURED
  UNAVAILABLE
  USED
  SKIPPED
}

/// Which website connector produced a scan. Recorded per attempt because the
/// configured connector can change between runs.
enum BrandConnectorMode {
  FIXTURE
  NOT_CONFIGURED
}

enum PageClassification {
  HOME
  PRODUCT
  SERVICE
  ABOUT
  FAQ
  CONTACT
  LEGAL
  OTHER
  UNKNOWN
}

enum PageFetchStatus {
  FETCHED
  FAILED
  SKIPPED_ROBOTS
  SKIPPED_LIMIT
}

enum ProductServiceKind {
  PRODUCT
  SERVICE
}

enum DiscoveryTier {
  REQUIRED_FOR_APPROVAL
  DISCOVER_WHEN_AVAILABLE
  DEFERRED_ADVANCED
}

enum BrandInfoState {
  OBSERVED
  AI_INFERRED
  USER_CONFIRMED
  USER_CORRECTED
  STALE
}

enum ExtractionMethod {
  HTML_META
  JSON_LD
  OG
  HEURISTIC
  USER
  AI
}

enum ProfileVersionStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  SUPERSEDED
  REJECTED
}

enum InsightReviewStatus {
  PENDING
  ACCEPTED
  REJECTED
  EDITED
}

enum HumanEditAction {
  EDIT
  ACCEPT
  REJECT_INSIGHT
  REJECT_VERSION
  APPROVE_VERSION
}

enum InsightCreatedBy {
  SYSTEM
  AI
  USER
}

enum StrategyStatus {
  ACTIVE
  ARCHIVED
}

enum StrategyVersionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUPERSEDED
  ARCHIVED
}

enum StrategyAiAvailability {
  NOT_CONFIGURED
  UNAVAILABLE
  REFUSED
}

enum StrategyInfoClass {
  BRAND_LINKED
  USER_AUTHORED
  ASSUMPTION
  UNKNOWN
  RECOMMENDATION
  AI_PROPOSAL
}

enum StrategyKpiAppliesTo {
  STRATEGY
  ORGANIC
  PAID
}

enum StrategyGapKind {
  RISK
  ASSUMPTION
  DEPENDENCY
  UNKNOWN
}

enum StrategyReviewAction {
  SUBMIT
  COMMENT
  REQUEST_CHANGES
  APPROVE_PACKAGE
  REJECT
  ARCHIVE
}

model BrandWorkspace {
  id                              String                     @id
  tenantId                        String
  name                            String
  status                          BrandWorkspaceStatus       @default(DRAFT)
  currentApprovedProfileVersionId String?
  /// Brand current approved strategy pointer (Feature 003). Never auto-set on approve.
  currentApprovedStrategyId       String?
  primaryWebsiteSourceId          String?
  version                         Int                        @default(1)
  createdAt                       DateTime                   @default(now())
  updatedAt                       DateTime                   @updatedAt
  archivedAt                      DateTime?
  tenant                          Tenant                     @relation(fields: [tenantId], references: [id])
  websiteSources                  WebsiteSource[]
  scanAttempts                    ScanAttempt[]
  discoveredPages                 DiscoveredPage[]
  discoveredProducts              DiscoveredProductService[]
  extractedObservations           ExtractedObservation[]
  evidenceExcerpts                EvidenceExcerpt[]
  profileVersions                 ProfileVersion[]
  insightClaims                   InsightClaim[]
  humanEdits                      HumanEdit[]
  reviewDecisions                 ReviewDecision[]
  strategies                      Strategy[]

  @@index([tenantId, status, updatedAt])
  @@index([tenantId, currentApprovedStrategyId])
}

model WebsiteSource {
  id                    String                  @id
  tenantId              String
  brandId               String
  normalizedUrl         String
  host                  String
  attestationAcceptedAt DateTime
  attestedByUserId      String
  validationStatus      WebsiteValidationStatus @default(VALID)
  validationReason      String?
  sourceRevision        Int                     @default(1)
  notes                 String?
  createdAt             DateTime                @default(now())
  replacedAt            DateTime?
  brand                 BrandWorkspace          @relation(fields: [brandId], references: [id])
  scanAttempts          ScanAttempt[]

  @@index([tenantId, brandId])
}

model ScanAttempt {
  id                    String                     @id
  tenantId              String
  brandId               String
  websiteSourceId       String
  status                ScanAttemptStatus          @default(QUEUED)
  trigger               ScanTrigger                @default(START)
  parentAttemptId       String?
  jobRunId              String                     @unique
  idempotencyKey        String                     @unique
  actorUserId           String
  correlationId         String?
  progressPercent       Int                        @default(0)
  pagesFetched          Int                        @default(0)
  pagesFailed           Int                        @default(0)
  pagesSkipped          Int                        @default(0)
  coverageJson          String?
  aiAvailability        BrandAiAvailability        @default(NOT_CONFIGURED)
  connectorMode         BrandConnectorMode         @default(NOT_CONFIGURED)
  errorCode             String?
  errorDetail           String?
  startedAt             DateTime?
  finishedAt            DateTime?
  cancelRequestedAt     DateTime?
  createdAt             DateTime                   @default(now())
  brand                 BrandWorkspace             @relation(fields: [brandId], references: [id])
  websiteSource         WebsiteSource              @relation(fields: [websiteSourceId], references: [id])
  discoveredPages       DiscoveredPage[]
  discoveredProducts    DiscoveredProductService[]
  extractedObservations ExtractedObservation[]
  evidenceExcerpts      EvidenceExcerpt[]
  profileVersions       ProfileVersion[]

  @@index([tenantId, brandId, createdAt])
}

model DiscoveredPage {
  id               String             @id
  tenantId         String
  brandId          String
  scanAttemptId    String
  url              String
  canonicalUrl     String
  canonicalHash    String
  title            String?
  httpStatus       Int?
  contentType      String?
  classification   PageClassification @default(UNKNOWN)
  fetchStatus      PageFetchStatus    @default(FETCHED)
  failureReason    String?
  localeHint       String?
  discoveredAt     DateTime           @default(now())
  brand            BrandWorkspace     @relation(fields: [brandId], references: [id])
  scanAttempt      ScanAttempt        @relation(fields: [scanAttemptId], references: [id])
  evidenceExcerpts EvidenceExcerpt[]

  @@unique([scanAttemptId, canonicalHash])
  @@index([tenantId, scanAttemptId])
}

model DiscoveredProductService {
  id              String             @id
  tenantId        String
  brandId         String
  scanAttemptId   String
  kind            ProductServiceKind
  name            String
  description     String?
  category        String?
  skuPublic       String?
  priceAmount     String?
  priceCurrency   String?
  availability    String?
  sourcePageId    String?
  parentProductId String?
  dedupeKey       String
  brand           BrandWorkspace     @relation(fields: [brandId], references: [id])
  scanAttempt     ScanAttempt        @relation(fields: [scanAttemptId], references: [id])

  @@unique([scanAttemptId, dedupeKey])
  @@index([tenantId, scanAttemptId])
}

model ExtractedObservation {
  id               String          @id
  tenantId         String
  brandId          String
  scanAttemptId    String
  fieldKey         String
  discoveryTier    DiscoveryTier
  valueJson        String?
  isUnknown        Boolean         @default(false)
  infoState        BrandInfoState  @default(OBSERVED)
  confidence       Float?
  evidenceId       String?
  profileVersionId String?
  immutable        Boolean         @default(true)
  brand            BrandWorkspace  @relation(fields: [brandId], references: [id])
  scanAttempt      ScanAttempt     @relation(fields: [scanAttemptId], references: [id])
  profileVersion   ProfileVersion? @relation(fields: [profileVersionId], references: [id])

  @@index([tenantId, scanAttemptId])
  @@index([profileVersionId])
}

model EvidenceExcerpt {
  id               String           @id
  tenantId         String
  brandId          String
  scanAttemptId    String
  sourceUrl        String
  canonicalUrl     String
  pageTitle        String?
  fetchedAt        DateTime         @default(now())
  excerptText      String
  contentHash      String
  extractionMethod ExtractionMethod
  discoveredPageId String?
  brand            BrandWorkspace   @relation(fields: [brandId], references: [id])
  scanAttempt      ScanAttempt      @relation(fields: [scanAttemptId], references: [id])
  discoveredPage   DiscoveredPage?  @relation(fields: [discoveredPageId], references: [id])
  insightClaims    InsightClaim[]

  @@index([tenantId, scanAttemptId])
}

/// Profile sections stored as JSON document on ProfileVersion.sectionsJson (overview, catalog, etc.)
model ProfileVersion {
  id                         String               @id
  tenantId                   String
  brandId                    String
  scanAttemptId              String?
  status                     ProfileVersionStatus @default(DRAFT)
  rowVersion                 Int                  @default(1)
  aiAvailability             BrandAiAvailability  @default(NOT_CONFIGURED)
  coverageSnapshotJson       String?
  sectionsJson               String?
  approvedAt                 DateTime?
  approvedByUserId           String?
  rejectedAt                 DateTime?
  rejectedByUserId           String?
  incompletenessAcknowledged Boolean              @default(false)
  createdAt                  DateTime             @default(now())
  brand                      BrandWorkspace       @relation(fields: [brandId], references: [id])
  scanAttempt                ScanAttempt?         @relation(fields: [scanAttemptId], references: [id])
  observations               ExtractedObservation[]
  insightClaims              InsightClaim[]
  humanEdits                 HumanEdit[]
  reviewDecisions            ReviewDecision[]
  approvalRecord             ApprovalRecord?

  @@index([tenantId, brandId, createdAt])
}

model InsightClaim {
  id               String              @id
  tenantId         String
  brandId          String
  profileVersionId String
  fieldKey         String
  infoState        BrandInfoState      @default(OBSERVED)
  reviewStatus     InsightReviewStatus @default(PENDING)
  textValue        String?
  valueJson        String?
  evidenceId       String?
  discoveryTier    DiscoveryTier
  createdBy        InsightCreatedBy    @default(SYSTEM)
  rowVersion       Int                 @default(1)
  brand            BrandWorkspace      @relation(fields: [brandId], references: [id])
  profileVersion   ProfileVersion      @relation(fields: [profileVersionId], references: [id])
  evidence         EvidenceExcerpt?    @relation(fields: [evidenceId], references: [id])
  humanEdits       HumanEdit[]

  @@index([tenantId, profileVersionId])
}

model HumanEdit {
  id                    String          @id
  tenantId              String
  brandId               String
  profileVersionId      String
  insightId             String?
  actorUserId           String
  action                HumanEditAction
  beforeRef             String?
  afterRef              String?
  acknowledgeIncomplete Boolean         @default(false)
  correlationId         String?
  createdAt             DateTime        @default(now())
  brand                 BrandWorkspace  @relation(fields: [brandId], references: [id])
  profileVersion        ProfileVersion  @relation(fields: [profileVersionId], references: [id])
  insight               InsightClaim?   @relation(fields: [insightId], references: [id])

  @@index([tenantId, profileVersionId])
}

model ReviewDecision {
  id                    String          @id
  tenantId              String
  brandId               String
  profileVersionId      String
  insightId             String?
  actorUserId           String
  action                HumanEditAction
  beforeRef             String?
  afterRef              String?
  acknowledgeIncomplete Boolean         @default(false)
  correlationId         String?
  createdAt             DateTime        @default(now())
  brand                 BrandWorkspace  @relation(fields: [brandId], references: [id])
  profileVersion        ProfileVersion  @relation(fields: [profileVersionId], references: [id])

  @@index([tenantId, profileVersionId])
}

model ApprovalRecord {
  id                     String         @id
  tenantId               String
  brandId                String
  profileVersionId       String         @unique
  actorUserId            String
  acknowledgedIncomplete Boolean        @default(false)
  warningsJson           String?
  coverageSnapshotJson   String?
  createdAt              DateTime       @default(now())
  profileVersion         ProfileVersion @relation(fields: [profileVersionId], references: [id])
}

/// Feature 003 — Strategy container (soft-archive only).
model Strategy {
  id               String            @id
  tenantId         String
  brandId          String
  name             String
  status           StrategyStatus    @default(ACTIVE)
  originStrategyId String?
  createdByUserId  String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  archivedAt       DateTime?
  brand            BrandWorkspace    @relation(fields: [brandId], references: [id])
  versions         StrategyVersion[]

  @@index([tenantId, brandId, updatedAt])
  @@index([tenantId, brandId, status])
}

/// Immutable when status not DRAFT. Content PATCH Draft-only.
model StrategyVersion {
  id                             String                             @id
  tenantId                       String
  brandId                        String
  strategyId                     String
  status                         StrategyVersionStatus              @default(DRAFT)
  rowVersion                     Int                                @default(1)
  versionNumber                  Int
  linkedApprovedProfileVersionId String?
  draftProfileVersionId          String?
  organicEnabled                 Boolean                            @default(true)
  paidEnabled                    Boolean                            @default(false)
  organicDisabledRationale       String?
  paidDisabledRationale          String?
  aiAvailability                 StrategyAiAvailability             @default(NOT_CONFIGURED)
  foundationJson                 String?
  unknownsAcknowledged           Boolean                            @default(false)
  submittedAt                    DateTime?
  submittedByUserId              String?
  approvedAt                     DateTime?
  approvedByUserId               String?
  rejectedAt                     DateTime?
  rejectedByUserId               String?
  supersedesVersionId            String?
  createdAt                      DateTime                           @default(now())
  updatedAt                      DateTime                           @updatedAt
  strategy                       Strategy                           @relation(fields: [strategyId], references: [id])
  organicTrack                   StrategyOrganicTrack?
  paidTrack                      StrategyPaidTrack?
  audiences                      StrategyAudience[]
  competitors                    StrategyCompetitorReference[]
  kpis                           StrategyKpi[]
  gaps                           StrategyRiskAssumptionDependency[]
  evidenceLinks                  StrategyEvidenceLink[]
  comments                       StrategyComment[]
  reviewDecisions                StrategyReviewDecision[]
  approvalRecord                 StrategyApprovalRecord?
  humanEdits                     StrategyHumanEdit[]

  @@unique([strategyId, versionNumber])
  @@index([tenantId, brandId, strategyId, createdAt])
  @@index([linkedApprovedProfileVersionId])
}

model StrategyOrganicTrack {
  id                  String          @id
  tenantId            String
  brandId             String
  strategyVersionId   String          @unique
  pillarsJson         String?
  channelsJson        String?
  formatsJson         String?
  frequency           String?
  communityGoals      String?
  growthGoals         String?
  messageCta          String?
  funnelStagesJson    String?
  kpisJson            String?
  ownerRoleLabelsJson String?
  dependenciesJson    String?
  rowVersion          Int             @default(1)
  version             StrategyVersion @relation(fields: [strategyVersionId], references: [id])
}

model StrategyPaidTrack {
  id                     String          @id
  tenantId               String
  brandId                String
  strategyVersionId      String          @unique
  campaignObjectivesJson String?
  funnelStagesJson       String?
  audiencesJson          String?
  offerAngle             String?
  formatsJson            String?
  placementsJson         String?
  /// Planning-only budget — not live spend.
  budgetAmount           Decimal?        @db.Decimal(18, 2)
  budgetCurrency         String?
  allocationJson         String?
  expectedKpisJson       String?
  scheduleWindowStart    DateTime?
  scheduleWindowEnd      DateTime?
  landingDestination     String?
  approvalNotes          String?
  rowVersion             Int             @default(1)
  version                StrategyVersion @relation(fields: [strategyVersionId], references: [id])
}

model StrategyAudience {
  id                String            @id
  tenantId          String
  brandId           String
  strategyVersionId String
  name              String
  description       String?
  infoClass         StrategyInfoClass @default(USER_AUTHORED)
  sortOrder         Int               @default(0)
  version           StrategyVersion   @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId])
}

model StrategyCompetitorReference {
  id                String            @id
  tenantId          String
  brandId           String
  strategyVersionId String
  title             String
  sourceUrl         String?
  sourceNote        String?
  capturedAt        DateTime?
  uncertainty       String?
  infoClass         StrategyInfoClass @default(USER_AUTHORED)
  version           StrategyVersion   @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId])
}

model StrategyKpi {
  id                String               @id
  tenantId          String
  brandId           String
  strategyVersionId String
  name              String
  targetValue       String?
  unit              String?
  appliesTo         StrategyKpiAppliesTo @default(STRATEGY)
  infoClass         StrategyInfoClass    @default(USER_AUTHORED)
  version           StrategyVersion      @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId])
}

model StrategyRiskAssumptionDependency {
  id                String            @id
  tenantId          String
  brandId           String
  strategyVersionId String
  kind              StrategyGapKind
  text              String
  infoClass         StrategyInfoClass @default(ASSUMPTION)
  version           StrategyVersion   @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId])
}

model StrategyEvidenceLink {
  id                String          @id
  tenantId          String
  brandId           String
  strategyVersionId String
  evidenceExcerptId String?
  profileFieldKey   String?
  label             String?
  createdByUserId   String
  createdAt         DateTime        @default(now())
  version           StrategyVersion @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId])
}

model StrategyComment {
  id                String          @id
  tenantId          String
  brandId           String
  strategyVersionId String
  actorUserId       String
  body              String
  anchorPath        String?
  createdAt         DateTime        @default(now())
  version           StrategyVersion @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId, createdAt])
}

model StrategyReviewDecision {
  id                String               @id
  tenantId          String
  brandId           String
  strategyVersionId String
  actorUserId       String
  action            StrategyReviewAction
  comment           String?
  capabilityCode    String
  correlationId     String?
  createdAt         DateTime             @default(now())
  version           StrategyVersion      @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId, createdAt])
}

model StrategyApprovalRecord {
  id                             String          @id
  tenantId                       String
  brandId                        String
  strategyVersionId              String          @unique
  actorUserId                    String
  capabilityCode                 String
  linkedApprovedProfileVersionId String
  organicEnabled                 Boolean
  paidEnabled                    Boolean
  comment                        String?
  unknownsAcknowledged           Boolean         @default(false)
  createdAt                      DateTime        @default(now())
  version                        StrategyVersion @relation(fields: [strategyVersionId], references: [id])
}

model StrategyHumanEdit {
  id                String          @id
  tenantId          String
  brandId           String
  strategyVersionId String
  actorUserId       String
  fieldPath         String
  beforeRef         String?
  afterRef          String?
  correlationId     String?
  createdAt         DateTime        @default(now())
  version           StrategyVersion @relation(fields: [strategyVersionId], references: [id])

  @@index([tenantId, strategyVersionId])
}

// ─── Campaign & Content (operations domain) ───────────────────────────

enum Track {
  ORGANIC
  PAID
}

enum CampaignStatus {
  DRAFT
  UPCOMING
  ACTIVE
  IN_REVIEW
  NEEDS_ATTENTION
  COMPLETED
  ARCHIVED
}

enum ContentType {
  POST
  REEL
  CAROUSEL
  STATIC
  STORY
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  PUBLISHED_SAMPLE
}

enum ContentApprovalState {
  NOT_REQUESTED
  PENDING
  PARTIALLY_APPROVED
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum ContentScheduleState {
  UNSCHEDULED
  SCHEDULED
}

enum ContentApprovalPolicy {
  NONE
  OPTIONAL
  REQUIRED
}

model Campaign {
  id             String         @id
  tenantId       String
  brandId        String
  nameEn         String
  nameAr         String
  descriptionEn  String?
  descriptionAr  String?
  objectiveEn    String?
  objectiveAr    String?
  audienceEn     String?
  audienceAr     String?
  channels       String[]       @default([])
  strategyId     String?
  budgetAmount   Float?
  budgetCurrency String?        @default("USD")
  track          Track
  status         CampaignStatus @default(DRAFT)
  timelineStart  DateTime       @db.Date
  timelineEnd    DateTime       @db.Date
  ownerUserId    String?
  links          String[]       @default([])
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  contentItems   ContentItem[]

  @@index([tenantId, brandId])
  @@index([brandId, status])
  @@index([tenantId, status])
}

model ContentItem {
  id               String               @id
  tenantId         String
  brandId          String
  campaignId       String?
  titleEn          String
  titleAr          String
  captionEn        String?
  captionAr        String?
  contentType      ContentType
  channel          String
  track            Track
  status           ContentStatus        @default(DRAFT)
  approvalState    ContentApprovalState @default(NOT_REQUESTED)
  scheduleState    ContentScheduleState @default(UNSCHEDULED)
  plannedAt        DateTime?
  scheduledAt      DateTime?
  timezone         String               @default("Asia/Dubai")
  approverRequired Int                  @default(1)
  approverApproved Int                  @default(0)
  previewAssetUrl  String?
  labels           String[]             @default([])
  assigneeUserId   String?
  clientVisible    Boolean              @default(true)
  archivedAt       DateTime?
  createdBy        String
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  campaign         Campaign?            @relation(fields: [campaignId], references: [id])
  approvalEvents   ContentApprovalEvent[]
  comments         ContentComment[]

  @@index([tenantId, brandId])
  @@index([brandId, campaignId])
  @@index([brandId, status])
  @@index([scheduledAt])
}

model ContentApprovalEvent {
  id          String      @id
  tenantId    String
  contentId   String
  actorUserId String
  action      String
  noteEn      String?
  noteAr      String?
  at          DateTime    @default(now())
  content     ContentItem @relation(fields: [contentId], references: [id])

  @@index([contentId, at])
  @@index([tenantId, contentId])
}

model ContentPreferences {
  brandId         String                @id
  tenantId        String
  approvalPolicy  ContentApprovalPolicy @default(OPTIONAL)
  defaultTimezone String                @default("Asia/Dubai")
  updatedAt       DateTime              @updatedAt
}

// --- CalendarDayNote Added Models ---

model CalendarDayNote {
  id        String   @id
  tenantId  String
  brandId   String
  dayKey    String
  textEn    String   @default("")
  textAr    String   @default("")
  color     String   @default("yellow")
  locked    Boolean  @default(false)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, dayKey])
  @@index([tenantId, brandId])
}

model ContentLabel {
  id        String   @id
  tenantId  String
  brandId   String
  nameEn    String
  nameAr    String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brandId, nameEn])
  @@index([tenantId, brandId])
}

model ContentTemplate {
  id              String      @id
  tenantId        String
  brandId         String
  nameEn          String
  nameAr          String
  titleEn         String?
  titleAr         String?
  captionEn       String?
  captionAr       String?
  contentType     ContentType @default(POST)
  channel         String      @default("instagram")
  track           Track       @default(ORGANIC)
  labels          String[]    @default([])
  previewAssetUrl String?
  createdBy       String
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, brandId])
}

/// Tenant-scoped workspace general + approval settings (Planable Workspace Settings).
model WorkspaceSetting {
  id                    String   @id
  tenantId              String   @unique
  websiteUrl            String?
  timezone              String   @default("Asia/Jerusalem")
  createPostsAsInternal Boolean  @default(false)
  hideEmailsFromClients Boolean  @default(false)
  autoCropImages        Boolean  @default(true)
  /// none | optional | required | multi_level
  approvalMode          String   @default("optional")
  scheduleOnApproval    Boolean  @default(false)
  lockAfterApproval     Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Preferred publishing time slots (Planable Timetable).
model WorkspaceTimeSlot {
  id        String   @id
  tenantId  String
  /// 0=Sunday .. 6=Saturday (or 1=Monday..7 — app uses 0-6 Mon-first via label)
  dayOfWeek Int
  /// HH:mm local
  timeLocal String
  color     String   @default("#fde68a")
  label     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, dayOfWeek, timeLocal])
  @@index([tenantId])
}



model ContentComment {
  id          String      @id
  tenantId    String
  contentId   String
  authorUserId String
  bodyEn      String
  bodyAr      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  content     ContentItem @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([tenantId, contentId])
}

enum WorkRequestStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELLED
}

enum WorkRequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkRequestType {
  CONTENT
  DESIGN
  REVIEW
  OTHER
}

model WorkRequest {
  id             String             @id
  tenantId       String
  brandId        String
  campaignId     String?
  contentId      String?
  titleEn        String
  titleAr        String
  descriptionEn  String             @default("")
  descriptionAr  String             @default("")
  type           WorkRequestType    @default(CONTENT)
  priority       WorkRequestPriority @default(MEDIUM)
  status         WorkRequestStatus  @default(OPEN)
  dueAt          DateTime?
  requesterUserId String
  assigneeUserId String?
  channels       String[]           @default([])
  formats        String[]           @default([])
  /// Production brief gate (objective / audience / key message). READY when all three are non-empty.
  briefObjectiveEn   String          @default("")
  briefObjectiveAr   String          @default("")
  briefAudienceEn    String          @default("")
  briefAudienceAr    String          @default("")
  briefKeyMessageEn  String          @default("")
  briefKeyMessageAr  String          @default("")
  briefReadyAt       DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  tasks          WorkTask[]
  deliverables   WorkDeliverable[]

  @@index([tenantId, brandId])
  @@index([brandId, status])
  @@index([contentId])
}

enum WorkTaskStatus {
  BACKLOG
  TODO
  READY
  IN_PROGRESS
  BLOCKED
  IN_REVIEW
  DONE
  CANCELLED
  OVERDUE
}

enum WorkTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkDeliverableReviewStatus {
  NOT_STARTED
  DRAFT
  AWAITING_REVIEW
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
}

model WorkTask {
  id              String           @id
  tenantId        String
  brandId         String
  campaignId      String?
  requestId       String?
  contentId       String?
  titleEn         String
  titleAr         String
  descriptionEn   String           @default("")
  descriptionAr   String           @default("")
  status          WorkTaskStatus   @default(TODO)
  priority        WorkTaskPriority @default(MEDIUM)
  department      String           @default("")
  assigneeUserId  String?
  dueAt           DateTime?
  createdBy       String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  request         WorkRequest?     @relation(fields: [requestId], references: [id])
  deliverables    WorkDeliverable[]
  checklistItems  WorkTaskChecklistItem[]
  comments        WorkTaskComment[]

  @@index([tenantId, brandId])
  @@index([brandId, status])
  @@index([requestId])
}

enum WorkDeliverableStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  DELIVERED
  ARCHIVED
}

model WorkDeliverable {
  id              String                       @id
  tenantId        String
  brandId         String
  campaignId      String?
  requestId       String?
  taskId          String?
  contentId       String?
  titleEn         String
  titleAr         String
  status          WorkDeliverableStatus        @default(DRAFT)
  reviewStatus    WorkDeliverableReviewStatus  @default(NOT_STARTED)
  assetUrl        String?
  currentVersionId String?
  approvedVersionId String?
  createdBy       String
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  request         WorkRequest?                 @relation(fields: [requestId], references: [id])
  task            WorkTask?                    @relation(fields: [taskId], references: [id])
  versions        WorkDeliverableVersion[]
  annotations     WorkDeliverableAnnotation[]
  comments        WorkDeliverableComment[]

  @@index([tenantId, brandId])
  @@index([brandId, status])
  @@index([requestId])
  @@index([taskId])
}

/// Production parity with demo multi-version review.
model WorkDeliverableVersion {
  id              String         @id
  tenantId        String
  deliverableId   String
  label           String         @default("v1")
  versionNumber   Int            @default(1)
  assetUrl        String?
  notesEn         String         @default("")
  notesAr         String         @default("")
  /// DRAFT | IN_REVIEW | APPROVED | REJECTED | SUPERSEDED
  status          String         @default("DRAFT")
  createdBy       String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deliverable     WorkDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, versionNumber])
  @@index([tenantId, deliverableId])
}

model WorkDeliverableAnnotation {
  id              String         @id
  tenantId        String
  deliverableId   String
  versionId       String?
  authorUserId    String
  bodyEn          String
  bodyAr          String         @default("")
  /// normalized 0..1 canvas coords
  x               Float          @default(0.5)
  y               Float          @default(0.5)
  resolved        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deliverable     WorkDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, createdAt])
  @@index([tenantId, deliverableId])
}

model WorkDeliverableComment {
  id              String         @id
  tenantId        String
  deliverableId   String
  versionId       String?
  authorUserId    String
  bodyEn          String
  bodyAr          String         @default("")
  resolved        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deliverable     WorkDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId, createdAt])
  @@index([tenantId, deliverableId])
}

model WorkTaskChecklistItem {
  id          String   @id
  tenantId    String
  taskId      String
  titleEn     String
  titleAr     String   @default("")
  done        Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  task        WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sortOrder])
  @@index([tenantId, taskId])
}

model WorkTaskComment {
  id           String   @id
  tenantId     String
  taskId       String
  authorUserId String
  bodyEn       String
  bodyAr       String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  task         WorkTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([tenantId, taskId])
}
